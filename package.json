{
	"name": "vscode-dbml",
	"displayName": "vscode-dbml",
	"description": "Language support for the Database Markup Language",
	"icon": "images/dbml-logo.png",
	"version": "0.4.1",
	"publisher": "matt-meyers",
	"engines": {
		"vscode": "^1.140.0"
	},
	"categories": [
		"Programming Languages",
		"Snippets"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/mattmeyers/vscode-dbml.git"
	},
	"main": "./dist/main.js",
	"contributes": {
		"languages": [
			{
				"id": "dbml",
				"aliases": [
					"DBML",
					"dbml",
					"Database Markup Language"
				],
				"extensions": [
					".dbml"
				],
				"icon": {
					"dark": "./icons/dbml-logo.svg",
					"light": "./icons/dbml-logo.svg"
				},
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "dbml",
				"scopeName": "source.dbml",
				"path": "./syntaxes/dbml.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "dbml",
				"path": "./snippets/dbml.json"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "vscode-dbml.export",
					"when": "editorLangId == dbml"
				},
				{
					"command": "vscode-dbml.import",
					"when": "editorLangId == sql"
				}
			]
		},
		"commands": [
			{
				"command": "vscode-dbml.export",
				"title": "To SQL",
				"category": "DBML"
			},
			{
				"command": "vscode-dbml.import",
				"title": "From SQL",
				"category": "DBML"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/main.js --sourcemap --minify",
		"build": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/main.js --sourcemap",
		"watch": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/main.js --sourcemap --watch",
		"typecheck": "tsc --noEmit",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"@types/vscode": "^1.140.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@dbml/core": "^11.0.0"
	},
	"__metadata": {
		"id": "4cea5698-223c-41b3-809b-a904d516f061",
		"publisherDisplayName": "Matt Meyers",
		"publisherId": "568bceb1-d747-4b35-8b70-2913492d364a"
	}
}
