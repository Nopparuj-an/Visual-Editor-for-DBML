{
	"name": "dbml-visual-editor",
	"displayName": "Visual Editor for DBML",
	"description": "Offline visual editor and language support for DBML in VSCode: pan, zoom, arrange and edit your schema as a diagram.",
	"keywords": [
		"dbml",
		"database",
		"schema",
		"diagram",
		"erd",
		"entity relationship",
		"visual editor",
		"sql"
	],
	"license": "MIT",
	"icon": "images/dbml-logo.png",
	"version": "0.1.0",
	"publisher": "Nopparuj",
	"engines": {
		"vscode": "^1.140.0"
	},
	"categories": [
		"Programming Languages",
		"Snippets",
		"Visualization"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Nopparuj-an/Visual-Editor-for-DBML"
	},
	"homepage": "https://github.com/Nopparuj-an/Visual-Editor-for-DBML#readme",
	"bugs": {
		"url": "https://github.com/Nopparuj-an/Visual-Editor-for-DBML/issues"
	},
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "dbml",
				"aliases": [
					"DBML",
					"dbml",
					"Database Markup Language"
				],
				"extensions": [
					".dbml"
				],
				"icon": {
					"dark": "./icons/dbml-logo.svg",
					"light": "./icons/dbml-logo.svg"
				},
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "dbml",
				"scopeName": "source.dbml",
				"path": "./syntaxes/dbml.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "dbml",
				"path": "./snippets/dbml.json"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "dbmlVisualEditor.open",
					"when": "editorLangId == dbml"
				},
				{
					"command": "dbmlVisualEditor.toSql",
					"when": "editorLangId == dbml"
				},
				{
					"command": "dbmlVisualEditor.fromSql",
					"when": "editorLangId == sql"
				}
			],
			"editor/title": [
				{
					"command": "dbmlVisualEditor.open",
					"when": "editorLangId == dbml",
					"group": "navigation"
				}
			]
		},
		"commands": [
			{
				"command": "dbmlVisualEditor.open",
				"title": "Open Visual Editor to the Side",
				"category": "DBML",
				"icon": "$(open-preview)"
			},
			{
				"command": "dbmlVisualEditor.toSql",
				"title": "To SQL",
				"category": "DBML"
			},
			{
				"command": "dbmlVisualEditor.fromSql",
				"title": "From SQL",
				"category": "DBML"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap --minify && esbuild src/webview/main.ts --bundle --platform=browser --format=iife --outfile=dist/webview.js --sourcemap --minify",
		"build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap && esbuild src/webview/main.ts --bundle --platform=browser --format=iife --outfile=dist/webview.js --sourcemap",
		"watch": "npm run build -- --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"package": "vsce package --no-dependencies"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"@types/vscode": "^1.140.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@dbml/core": "^11.0.0",
		"elkjs": "^0.12.0"
	},
	"author": {
		"name": "Nopparuj"
	}
}
